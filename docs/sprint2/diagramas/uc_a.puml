@startuml
!pragma layout smetana
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam shadowing false
skinparam ActorBorderColor #4E342E
skinparam ActorBackgroundColor #D7CCC8
skinparam ActorFontColor #3E2723
skinparam UsecaseBorderColor #2E7D32
skinparam UsecaseBackgroundColor #E8F5E9
skinparam UsecaseFontColor #1B1B1B
skinparam RectangleBorderColor #6D4C41
skinparam RectangleBackgroundColor #FFF8F2
skinparam RectangleFontColor #3E2723
skinparam ArrowColor #5D4037
skinparam ArrowFontColor #3E2723
skinparam EntityBackgroundColor #FFF8F2
skinparam EntityBorderColor #6D4C41
skinparam ClassBackgroundColor #FFF8F2
skinparam ClassBorderColor #6D4C41
skinparam ClassFontColor #1B1B1B
skinparam ClassAttributeFontColor #1B1B1B
skinparam ClassHeaderBackgroundColor #D7CCC8
left to right direction
actor "Usuario interno" as USR
actor "Administrador" as ADM
actor "Gerente /\nEjecutivo" as GER
actor "Operador de\nexportaciones" as OPX
ADM --|> USR
GER --|> USR
OPX --|> USR
rectangle "Usuarios, Clientes y Productos" {
  usecase "UC-01\nIniciar sesión" as UC01
  usecase "UC-02\nGestionar usuarios y roles" as UC02
  usecase "UC-03\nRegistrar cliente" as UC03
  usecase "UC-04\nConsultar y editar cliente" as UC04
  usecase "UC-05\nRegistrar y consultar productos del catálogo" as UC05
}
USR --> UC01
ADM --> UC02
ADM --> UC03
OPX --> UC03
ADM --> UC04
OPX --> UC04
GER --> UC04
ADM --> UC05
OPX --> UC05
@enduml
