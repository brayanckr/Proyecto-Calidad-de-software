{
  "name": "coffeeexport-manager-frontend",
  "version": "0.3.0",
  "private": true,
  "description": "Prototipo de interfaz de CoffeeExport Manager (RITECH SAS) y sus pruebas automáticas.",
  "scripts": {
    "test:unit": "node --test --test-reporter=spec \"tests/unit/*.test.js\"",
    "test:integration": "node --test --test-reporter=spec --test-concurrency=1 \"tests/integration/*.test.js\"",
    "test": "npm run test:unit && npm run test:integration",
    "test:junit": "node --test --test-reporter=junit --test-concurrency=1 \"tests/unit/*.test.js\" \"tests/integration/*.test.js\""
  },
  "devDependencies": {
    "playwright-core": "^1.50.0"
  },
  "engines": {
    "node": ">=20"
  }
}
